# Canonical URLs and sitemap generation stay disabled until the client confirms
# the live domain (the package ships NEEDS_CLIENT_DOMAIN).
VITE_SITE_URL=https://www.example.com

# Enquiry delivery. Set this to your form provider's submit endpoint
# (Formspree, Web3Forms, Basin, a serverless function, etc.).
# Without it the contact form reports "not configured" instead of faking success.
# Never put a private/access key here — only the public endpoint URL.
VITE_FORM_ENDPOINT=
